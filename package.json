{
  "name": "pttbbs-web",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",

    "build": "rm -rf dist && tsc -b && vite build && mv dist/htmls/*.html dist/ && ln -s all.html dist/index.html",
    "dev": "vite",
    "preview": "vite preview",

    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest"
  },
  "dependencies": {
    "use-thunk": "^16.1.2",
    "bootstrap": "^5.3.8",
