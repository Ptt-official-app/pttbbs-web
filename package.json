    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^6.30.3",
    "react-use": "^17.6.0",
    "react-widgets": "^5.8.6",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
